# API — backend base URL (Django DRF)
VITE_API_URL=http://localhost:8000/api/v1

# Feature flags (uncomment to enable)
# VITE_FEATURE_MESSAGES=true
# VITE_FEATURE_LIVE_SESSIONS=true
# VITE_FEATURE_ANALYTICS=true

# Google OAuth Client ID (public — safe to default; NEVER put the client *secret* here,
# the frontend Identity Services flow only ever needs the client ID)
VITE_GOOGLE_CLIENT_ID=440041713770-tvs55jh8h5batgsf1iha96b85en7tek3.apps.googleusercontent.com

# Observability (leave empty in dev)
VITE_SENTRY_DSN=
VITE_APP_ENV=development
