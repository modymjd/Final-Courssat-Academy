# ============================================================================
# Courssat Academy - Production Environment Variables
# ============================================================================

# --- Django Settings ---
SECRET_KEY=change_me_to_a_secure_random_string
DEBUG=False
ALLOWED_HOSTS=courssat.online,api.courssat.online,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://courssat.online,https://www.courssat.online
CSRF_TRUSTED_ORIGINS=https://courssat.online,https://www.courssat.online
FRONTEND_URL=https://courssat.online
FRONTEND_BASE_URL=https://courssat.online

# --- Database (PostgreSQL) ---
DB_NAME=courssat_prod
DB_USER=courssat_admin
DB_PASSWORD=change_me_secure_db_password
DB_HOST=postgres
DB_PORT=5432

# --- Redis (Cache & Celery Broker) ---
REDIS_PASSWORD=change_me_secure_redis_password
REDIS_URL=redis://:change_me_secure_redis_password@redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://:change_me_secure_redis_password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change_me_secure_redis_password@redis:6379/2
# Also hard-forced to False in config/settings/production.py — kept here for visibility.
CELERY_TASK_ALWAYS_EAGER=False
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120

# --- Video HLS Streaming (DRM) ---
NGINX_SECURE_LINK_SECRET=change_me_to_secure_hls_secret
# Keep False only for a small controlled pilot. A 500-viewer launch must use
# a validated external video provider/CDN and set this to True.
REQUIRE_VIDEO_CDN=False
VIDEO_STORAGE_ADAPTER=local

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_admin_password

# --- External Services (Example) ---
# GOOGLE_CLIENT_ID=
# SENTRY_DSN=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_TOKEN_KEY=
# KASHIER_MERCHANT_ID=
# KASHIER_API_KEY=
# KASHIER_IFRAME_KEY=
# KASHIER_SECRET_KEY=
# KASHIER_WEBHOOK_SECRET=

# --- Sensitive student-data encryption ---
# Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NATIONAL_ID_FERNET_KEYS=
NATIONAL_ID_PEPPER=
