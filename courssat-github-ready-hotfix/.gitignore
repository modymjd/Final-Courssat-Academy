# Rendered nginx config (contains secrets at runtime) — generated into a
# container tmpfs at deploy time, must never be committed. See conf.d/.gitkeep.
infrastructure/nginx/conf.d/*.conf
infrastructure/nginx/certbot-conf/*
!infrastructure/nginx/certbot-conf/.gitkeep
infrastructure/nginx/certbot-www/*
!infrastructure/nginx/certbot-www/.gitkeep

